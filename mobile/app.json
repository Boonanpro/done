{
  "expo": {
    "name": "Done",
    "slug": "dan-mobile",
    "version": "1.0.82",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#12110f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.done.dan"
    },
    "android": {
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "versionCode": 81,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#12110f"
      },
      "package": "app.done.dan",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/dan_ring.wav"
          ]
        }
      ],
      "./plugins/withDanSmsForwarder",
      "./plugins/withDanVoiceCall",
      "./plugins/withDanAppUpdate",
      [
        "expo-image-picker",
        {
          "photosPermission": "DANで画像や動画を送るために写真ライブラリへのアクセスを許可してください。",
          "cameraPermission": "DANで写真を撮って送るためにカメラへのアクセスを許可してください。"
        }
      ],
      "expo-video",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "DANで受け取った画像や動画を写真に保存するためにアクセスを許可してください。",
          "photosPermission": "DANで受け取った画像や動画を写真に保存するためにアクセスを許可してください。",
          "granularPermissions": ["photo", "video"]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "現在地をダンに知らせて、「この近く」「今いる所」の質問に答えられるようにします（アプリを開いている間だけ）。",
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://dan.paina.info",
      "eas": {
        "projectId": "db295575-26c1-4088-99aa-4887eb27e2e2"
      }
    },
    "owner": "done-is-better",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/db295575-26c1-4088-99aa-4887eb27e2e2",
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    }
  }
}
