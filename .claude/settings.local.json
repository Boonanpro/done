{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Edit(*)",
      "Write(*)",
      "WebFetch(*)",
      "WebSearch",
      "PowerShell(Get-ScheduledTask *)",
      "PowerShell(Get-Process *)",
      "PowerShell(Get-NetTCPConnection *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python D:/done/scripts/hook_create_feature_guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python D:/done/scripts/hook_autoinstall_shadcn.py"
          },
          {
            "type": "command",
            "command": "python D:/done/scripts/hook_autoinstall_npm.py"
          },
          {
            "type": "command",
            "command": "python D:/done/scripts/hook_register_artifact.py"
          },
          {
            "type": "command",
            "command": "python D:/done/scripts/hook_forbid_overlay_pattern.py"
          }
        ]
      }
    ]
  }
}
